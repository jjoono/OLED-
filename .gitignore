__pycache__/
*.pyc
# CP2K run artefacts (regenerated by running the inputs)
dft_seedlayer_screen/slabs/**/*.out
dft_seedlayer_screen/slabs/**/*.wfn
dft_seedlayer_screen/slabs/**/*.wfn.bak-*
dft_seedlayer_screen/slabs/**/*-RESTART*
# psi4 scratch and raw logs (regenerated by rerunning the scripts)
dft_seedlayer_screen/psi.*.clean
timer.dat
dft_seedlayer_screen/timer.dat
# psi4 raw output, whatever the driver names it. The prefix-anchored rule
# missed the diagnostic runs (diag*.out); no .out under runs/ is a result --
# the numbers that matter land in the .json each script writes.
dft_seedlayer_screen/runs/*.out
dft_seedlayer_screen/runs/*_run.log
# Console logs of the psi4/CP2K driver scripts. These are written incrementally
# while a calculation is in flight, so committing one captures a truncated file.
# The results that matter are the .json each script writes at the end, plus the
# REPORT*.md that interprets them -- both of which are tracked.
dft_seedlayer_screen/runs/*.log
dft_seedlayer_screen/runs/tddft_absorption.json.tmp
# xtb working directories. The optimised geometry (xtbopt.xyz) is kept, matching
# runs/xtb/*/xtbopt.xyz, and is also copied into structures/. Everything else the
# driver writes is scratch regenerated on every run.
dft_seedlayer_screen/runs/**/xtb.log
dft_seedlayer_screen/runs/**/xtbopt.log
dft_seedlayer_screen/runs/**/xtbrestart
dft_seedlayer_screen/runs/**/xtbtopo.mol
dft_seedlayer_screen/runs/**/charges
dft_seedlayer_screen/runs/**/wbo
dft_seedlayer_screen/runs/**/in.xyz
dft_seedlayer_screen/runs/**/.xtboptok

# ellipsometry: data and outputs stay local
ellipsometry/data/
ellipsometry/out/
ellipsometry/**/*.npz
dft_seedlayer_screen/data/TR_20260819/
dft_seedlayer_screen/ppt/node_modules/
dft_seedlayer_screen/ppt/package-lock.json
dft_seedlayer_screen/ppt/*.pdf
