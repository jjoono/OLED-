! HATCN monolayer, clean reference
! generated by scripts/38_build_slabs.py
! NOTE: needs UPF pseudopotentials in pseudo_dir. Fetch from
!   https://pseudopotentials.quantum-espresso.org/upf_files/<name>
! required here: C.pbe-n-kjpaw_psl.1.0.0.UPF, N.pbe-n-kjpaw_psl.1.0.0.UPF
&CONTROL
  calculation = 'scf'
  prefix = 'hatcn_ml'
  outdir = './out'
  pseudo_dir = './pseudo'
  tprnfor = .true.
  tstress = .false.
/
&SYSTEM
  ibrav = 0
  nat = 30
  ntyp = 2
  ecutwfc = 60
  ecutrho = 480
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  vdw_corr = 'grimme-d3'
  assume_isolated = '2D'
/
&ELECTRONS
  conv_thr = 1.0d-6
  mixing_beta = 0.3
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  C 12.0110 C.pbe-n-kjpaw_psl.1.0.0.UPF
  N 14.0070 N.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
