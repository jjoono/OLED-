! LiF(001) 2x2 4-layer slab, clean
! generated by scripts/38_build_slabs.py
! NOTE: needs UPF pseudopotentials in pseudo_dir. Fetch from
!   https://pseudopotentials.quantum-espresso.org/upf_files/<name>
! required here: F.pbe-n-kjpaw_psl.1.0.0.UPF, Li.pbe-s-kjpaw_psl.1.0.0.UPF
&CONTROL
  calculation = 'scf'
  prefix = 'lif001'
  outdir = './out'
  pseudo_dir = './pseudo'
  tprnfor = .true.
  tstress = .false.
/
&SYSTEM
  ibrav = 0
  nat = 64
  ntyp = 2
  ecutwfc = 60
  ecutrho = 480
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  vdw_corr = 'grimme-d3'
  assume_isolated = '2D'
/
&ELECTRONS
  conv_thr = 1.0d-6
  mixing_beta = 0.3
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  F 18.9984 F.pbe-n-kjpaw_psl.1.0.0.UPF
  Li 6.9400 Li.pbe-s-kjpaw_psl.1.0.0.UPF

