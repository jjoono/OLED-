! isolated Ag atom in the HATCN cell (E_b reference)
! generated by scripts/38_build_slabs.py
! NOTE: needs UPF pseudopotentials in pseudo_dir. Fetch from
!   https://pseudopotentials.quantum-espresso.org/upf_files/<name>
! required here: Ag.pbe-n-kjpaw_psl.1.0.0.UPF
&CONTROL
  calculation = 'scf'
  prefix = 'ag_atom'
  outdir = './out'
  pseudo_dir = './pseudo'
  tprnfor = .true.
  tstress = .false.
/
&SYSTEM
  ibrav = 0
  nat = 1
  ntyp = 1
  ecutwfc = 60
  ecutrho = 480
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  vdw_corr = 'grimme-d3'
  assume_isolated = '2D'
/
&ELECTRONS
  conv_thr = 1.0d-6
  mixing_beta = 0.3
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  Ag 107.8682 Ag.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
     15.000000     0.000000     0.000000
     -7.500000    12.990381     0.000000
      0.000000     0.000000    18.000000

ATOMIC_POSITIONS angstrom
  Ag     0.000000     0.000000     9.000000

K_POINTS automatic
3 3 1 0 0 0
