-            names=column_names,
+            names=file_column_names,
             engine="python",
             skip_blank_lines=False,
         )
@@ -104,6 +115,21 @@ def read_multiple_files(
         for name in column_names:
             data_frame.loc[file_synonyms[i], name] = file_data_list[name].to_list()
 
+        # The extra sigma column only exists for accurate EQE files; create it
+        # on demand and set the single cell with .at (setting a list into a
+        # not-yet-existing column via .loc raises on newer pandas)
+        for name in file_column_names:
+            if name not in column_names:
+                if name not in data_frame.columns:
+                    data_frame[name] = pd.Series(
+                        [None] * len(data_frame),
+                        index=data_frame.index,
+                        dtype=object,
+                    )
+                data_frame.at[file_synonyms[i], name] = file_data_list[
+                    name
+                ].to_list()
+
         i += 1
 
     return data_frame
