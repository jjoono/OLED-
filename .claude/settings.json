{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(conda:*)",
      "Bash(source:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(xtb:*)",
      "Bash(cp2k.psmp:*)",
      "Bash(*/cp2k.psmp:*)",
      "Bash(bash dft_seedlayer_screen/scripts/*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(nproc:*)",
      "Bash(free:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(ps:*)",
      "Bash(pgrep:*)",
      "Bash(kill:*)",
      "Bash(nohup:*)",
      "Bash(setsid:*)",
      "Bash(timeout:*)",
      "Bash(export:*)",
      "Bash(echo:*)",
      "Bash(rm /tmp/psi*)",
      "Bash(rm -rf /tmp/psi*)",
      "Bash(rm dft_seedlayer_screen/slabs/**)",
      "Read(**)",
      "Edit(dft_seedlayer_screen/**)",
      "Write(dft_seedlayer_screen/**)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(sudo:*)",
      "Bash(curl:* | bash)",
      "Bash(wget:* | bash)"
    ]
  },
  "env": {
    "OMP_NUM_THREADS": "12",
    "CP2K_MEM_BUDGET_GB": "20"
  }
}
